# Copy to .env and fill in. Never commit .env.

# Cloudflare account ID: shown in the right sidebar of the Cloudflare dashboard.
CLOUDFLARE_ACCOUNT_ID=

# Only needed for CI or the offline embedding script. Locally, `npx wrangler login` is simpler.
CLOUDFLARE_API_TOKEN=

# From console.anthropic.com. Used by the offline scripts in /data/scripts.
# For the deployed Worker, set it as a secret instead: npx wrangler secret put ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# AI_GATEWAY_ID is not set here: it lives in wrangler.jsonc under "vars".
