# Cloudflare — get these from dash.cloudflare.com
CLOUDFLARE_API_TOKEN=          # API token with Workers, D1, R2, KV, Pages Write permissions
CLOUDFLARE_ACCOUNT_ID=         # Found in the right sidebar of any Cloudflare dashboard page

# Cloudflare Workers vars (also set in wrangler.jsonc [vars])
CF_ACCOUNT_ID=                 # Same as CLOUDFLARE_ACCOUNT_ID
AI_GATEWAY_ID=                 # Name you gave your AI Gateway (AI > AI Gateway in dashboard)

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=             # Passed as a Worker secret: wrangler secret put ANTHROPIC_API_KEY

# LinkedIn OAuth — get from linkedin.com/developers
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# NVIDIA NIM (optional — for additional AI models)
NVIDIA_API_KEY=                # From build.nvidia.com after signing in and opening any model

# Local dev only
NODE_ENV=development
